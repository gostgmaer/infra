# ===== Domain Control (single place) =====
BASE_DOMAIN=domain.in
PORTAINER_SUBDOMAIN=portainer
TRAEFIK_DASHBOARD_SUBDOMAIN=domain-control

# ===== TLS / Let's Encrypt =====
LETSENCRYPT_EMAIL=infra@domain.in

# ===== Docker network name used by Traefik and routed apps =====
TRAEFIK_NETWORK_NAME=edge

# ===== Traefik dashboard basic auth =====
# Generate: docker run --rm httpd:2 htpasswd -nb admin yourpassword | sed 's/\$/\$\$/g'
TRAEFIK_DASHBOARD_USERS=admin:$$apr1$$H7Ds3VFH$$GiINpkQtKFJEQZ.K2UKWX0
